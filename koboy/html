/* CYBERPUNK SKIN — warna dan efek saja; ukuran, susunan, serta fungsi layout dipertahankan */
:root{--black:#03030a;--red:#a900ff;--red2:#4c16b8;--wine:#09051d;--yellow:#ffd21a;--yellow2:#ffb000;--white:#f7f4ff;--line:#00eaff}
