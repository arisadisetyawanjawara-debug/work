<title>Western Cowboy — Demo Lobby</title>
<style>
:root{--black:#050505;--red:#ed0909;--red2:#c90000;--wine:#4b0000;--yellow:#ffd000;--yellow2:#ffb900;--white:#fff;--line:#e6b500}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--black);font-family:Arial,Helvetica,sans-serif;color:#fff}button,input,select{font:inherit}button{cursor:pointer}
.page{display:none;min-height:100vh}.page.active{display:block}
.logo{display:flex;align-items:center;justify-content:center;width:290px;height:58px;position:relative;flex-shrink:0}
.logo img{display:block;max-width:100%;max-height:100%;object-fit:contain}
.logo-slot{display:block;width:clamp(120px,30vw,270px);height:58px;flex:0 1 270px}
.logo-slot {
  display: block;
  width: 250px;
  height: 75px;
  flex: 0 1 250px;
  overflow: hidden;
}

.logo-slot img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.register-header .logo-slot{position:absolute;left:50%;transform:translateX(-50%)}
.logo-fallback{font-size:clamp(21px,4vw,34px);font-weight:1000;letter-spacing:-1.3px;color:#eee;text-shadow:2px 2px 0 #5b0000,-1px -1px #999;white-space:nowrap}
.logo-fallback b{color:#e21b1b}
.logo-fallback small{display:block;font-size:8px;letter-spacing:2px;text-align:right;margin-top:-3px;color:#ddd}
.register-header{height:116px;background:#050505;display:flex;align-items:center;justify-content:center;position:relative;border-bottom:1px solid #250000}
.live{position:absolute;right:14px;top:22px;border:1px solid #ff3434;border-radius:32px;background:linear-gradient(#ff1c1c,#a90000);color:#fff;font-size:17px;font-weight:bold;padding:13px 21px}
.register-bg,.lobby-bg{min-height:calc(100vh - 116px);background-color:#510000;background-image:radial-gradient(ellipse at 12% 50%,#730800 0,transparent 43%),linear-gradient(72deg,transparent 0 7%,#9b790d44 7.2%,transparent 7.6%,transparent 10%,#9b790d33 10.2%,transparent 10.6%)}
.register{max-width:900px;margin:auto;padding:12px 18px 28px}
.formrow{display:grid;grid-template-columns:minmax(125px,34%) minmax(0,1fr);align-items:center;gap:12px;margin:11px 0 17px}
.formrow>label{font-size:clamp(15px,3.5vw,24px);line-height:1.08;letter-spacing:.2px}
.req{color:#ff7373}
.field{height:57px;width:100%;min-width:0;border:3px solid #c6c6c6;border-radius:10px;background:#fff;color:#555;padding:0 22px;font-size:clamp(15px,3.2vw,22px);box-shadow:inset 0 1px 3px #999}
.field:focus{outline:2px solid #0aa8e8;border-color:#eee}
.phone{display:flex;min-width:0}.prefix{height:57px;background:#ffb000;color:#111;border:2px solid #d9a000;border-radius:8px 0 0 8px;padding:0 13px;font-size:20px}.phone .field{border-radius:0 9px 9px 0;padding-left:16px}
.referral{display:grid;grid-template-columns:minmax(125px,34%) 1fr;gap:12px;font-size:clamp(15px,3.5vw,23px);margin:18px 0 25px}
.rule{border:0;border-top:2px solid #eee;margin:18px 0 15px}.subhead{font-size:clamp(18px,3.8vw,25px);font-weight:bold;margin:0 0 18px}
.captcha-line{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.captcha-img{width:clamp(155px,36vw,255px);height:52px;background:#050505;border:1px solid white;border-radius:7px;display:grid;place-items:center;color:#5f9bff;font-family:Georgia,serif;font-size:34px;font-style:italic;letter-spacing:4px;text-shadow:2px 1px #00f,-2px 0 #13a53c;transform:skew(-4deg)}
.refresh-captcha{height:52px;width:58px;border:0;border-radius:9px;background:#ffa900;color:#fff;font-size:28px;font-weight:bold}
.checks{margin:21px 0 14px;font-size:clamp(14px,3.2vw,21px);line-height:1.2}.checks label{display:block;margin:8px 0}.checks input{width:22px;height:22px;vertical-align:middle;accent-color:#0789ff}
.submit{width:100%;border:1px solid #ffd54a;border-radius:8px;background:linear-gradient(#ffcf00,#f4a900);color:#171000;font-weight:900;font-size:20px;padding:15px;box-shadow:0 3px 0 #8a4b00}
.demo-note{text-align:center;color:#ffd6a0;font-size:11px;line-height:1.5;margin-top:12px}
/* LOBBY HEADER */
.lobby-header{height:140px;background:#050505;display:flex;align-items:center;padding:12px 5%;gap:22px;position:relative;z-index:5}
.hamb{width:42px;height:44px;background:transparent;border:0;color:white;font-size:0;display:flex;flex-direction:column;justify-content:center;gap:7px;padding:4px}
.hamb span{height:4px;width:39px;background:#fff;border-radius:2px;display:block}
.lobby-header .logo{width:270px;justify-content:flex-start}
.deposit{margin-left:auto;background:linear-gradient(90deg,#df0000,#ff1b1b);border:1px solid #ff3434;color:#fff;font-weight:bold;font-size:20px;padding:17px 29px;border-radius:8px;min-width:170px}
.drawer{display:block;position:fixed;inset:0 auto 0 0;width:min(64vw,360px);z-index:19;background:#970000;padding:0;overflow-y:auto;transform:translateX(-105%);transition:transform .22s ease}
.drawer.open{transform:translateX(0)}
.marquee{height:22px;background:#080808;color:#aaa;overflow:hidden;font-size:14px;white-space:nowrap}
.userbar{background:linear-gradient(110deg,#f00,#c90000 65%,#ee1010);padding:30px 5%;min-height:175px;border-bottom:3px solid #e9ad00;position:relative}
.username{font-size:clamp(22px,4vw,34px);font-weight:500;text-transform:uppercase;margin:0 0 25px}
.balance{font-size:clamp(17px,3.3vw,25px)}.refresh-balance{position:absolute;right:5%;bottom:25px;background:#39b653;color:#fff;border:0;border-radius:8px;font-size:19px;font-weight:bold;padding:10px 14px}
.lobby-inner{max-width:1400px;margin:auto;padding:30px 18px 50px}
/* CATEGORY BUTTONS: fixed short height like the reference */
.categories{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px 8px;margin:0 0 22px;align-items:stretch}
.cat{height:72px;min-width:0;border:1px solid #e8a900;border-radius:16px;background:linear-gradient(135deg,#ffe000,#ffb900);color:#080808;font-weight:1000;font-style:italic;font-size:clamp(11px,2.1vw,20px);display:flex;align-items:center;justify-content:center;gap:7px;padding:5px 4px;line-height:1.02;box-shadow:0 3px 0 #8d5500;cursor:pointer;text-align:center}
.cat .ico{font-size:clamp(17px,2.7vw,27px);font-style:normal;flex-shrink:0}
.cat.selected{outline:2px solid #fff2a3;filter:brightness(1.08)}
.search{width:100%;height:58px;border:0;border-radius:9px;background:#fff;text-align:center;font-size:22px;color:#333;padding:10px;margin:0 0 34px}
.promo-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:25px;margin-bottom:26px}
.promo{min-height:390px;border:1px solid #ffdc00;border-radius:36px;background:linear-gradient(135deg,#e00000,#a90000 48%,#f00000);padding:20px 17px;box-shadow:inset 0 0 0 2px #ffb90066;display:flex;flex-direction:column;justify-content:center;overflow:hidden}
.promo-title{font-size:16px;font-weight:bold;line-height:1.5;margin-bottom:20px}.yellow-link{display:block;text-align:center;border:0;border-radius:35px;background:linear-gradient(#ffdf00,#ffb800);padding:13px 10px;color:#080808;font-size:22px;font-weight:bold;text-decoration:none;margin:4px 0 20px}
.promo label{font-size:19px;margin:0 0 8px}.promo select{height:49px;width:100%;border:1px solid #aaa;border-radius:30px;padding:0 15px;font-size:17px;background:#eee;color:#111}
.copybtn{align-self:flex-start;background:linear-gradient(#ffe000,#ffb900);border:0;border-radius:25px;padding:11px 20px;font-size:18px;font-weight:bold;margin-top:18px;color:#111}
.qr-placeholder{background:#fff;color:#111;border-radius:10px;width:88%;height:250px;margin:0 auto 18px;display:grid;place-items:center;text-align:center;padding:15px;border:8px solid #fff;outline:1px solid #ddd}
.qr-placeholder img{max-width:100%;max-height:100%;object-fit:contain}.qr-placeholder .qr-fallback{font-size:16px;line-height:1.5}.qr-fallback b{font-size:65px;display:block}
.qr-caption{text-align:center;font-size:21px;line-height:1.4}
.banner-placeholder{width:100%;height:108px;border:2px dashed #ffd500;background:linear-gradient(90deg,#32112c,#60265c,#27122c);display:grid;place-items:center;text-align:center;color:#ffe18a;font-weight:bold;letter-spacing:1px;padding:18px;margin:24px 0 40px}
.section-title{display:flex;align-items:center;gap:18px;font-weight:bold;font-size:22px;margin:26px 0 18px}.section-title:after{content:"";height:6px;background:#aaa;flex:1}
/* ADD / REMOVE CARDS IN THE GAME_ITEMS ARRAY IN JAVASCRIPT */
.game-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.game-card{height:145px;position:relative;overflow:hidden;border:1px solid #d5a900;border-radius:14px;background:linear-gradient(135deg,#251329,#771018);display:block;text-decoration:none;color:#ffe28a}
.game-card img{width:100%;height:100%;object-fit:cover;display:block}
.game-card .image-fallback{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:12px;background:linear-gradient(135deg,#26152b,#751016);font-size:17px;font-weight:bold}
.game-card .card-label{position:absolute;bottom:0;left:0;right:0;padding:7px 10px;text-align:center;background:#000b;color:#fff;font-size:12px;font-weight:bold}
.info-text{font-size:13px;line-height:1.6;color:#f2caca;margin:24px 0}
.foot{background:#050505;text-align:center;padding:25px 12px;color:#aaa;font-size:12px}
.toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,20px);opacity:0;background:#ffcf00;color:#111;font-weight:bold;padding:12px 18px;border-radius:9px;transition:.2s;z-index:20;max-width:90%;text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:650px){
 .lobby-header{height:140px;padding:10px 5%;gap:14px}.lobby-header .logo-slot{width:auto;flex:1;max-width:138px;height:42px}
