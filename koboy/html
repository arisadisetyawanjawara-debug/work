 .search{height:58px;font-size:22px;margin-bottom:34px}
 .promo-grid{gap:25px}.promo{min-height:390px;padding:15px 12px;border-radius:36px}.promo-title{font-size:clamp(12px,2.6vw,16px)}.yellow-link{font-size:clamp(14px,3.1vw,20px);padding:13px 5px}.promo label{font-size:clamp(14px,2.7vw,18px)}.promo select{font-size:clamp(12px,2.5vw,16px)}.copybtn{font-size:16px;padding:10px 16px}.qr-placeholder{height:250px;width:95%}.qr-caption{font-size:clamp(15px,3vw,20px)}
 .banner-placeholder{height:108px;margin:24px 0 40px}.game-card{height:130px}
}
@media(max-width:390px){
 .lobby-header{gap:8px;padding:8px 12px}.lobby-header .logo-slot{max-width:138px}.deposit{font-size:14px;padding:15px 10px}
